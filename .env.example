# Telegram bot token from @BotFather (t.me/botfather)
TELEGRAM_BOT_TOKEN=
# Telegram chat to bridge (numeric id)
TELEGRAM_CHAT_ID=

# Bale bot token from @botfather (ble.ir/botfather)
BALE_BOT_TOKEN=
# Bale chat to bridge (numeric id)
BALE_CHAT_ID=
# Bale Bot API base URL (default: official)
BALE_API_BASE_URL=https://tapi.bale.ai

# Bridge direction: telegram-to-bale | bale-to-telegram | bidirectional
BRIDGE_DIRECTION=bidirectional

# SQLite database path
DATABASE_PATH=./data/bridge.db
# Temporary media directory (wiped at startup)
TEMP_DIRECTORY=./data/tmp
# Per-direction queue capacity
QUEUE_SIZE=100
# Album collection window (e.g. 700ms, 1s)
ALBUM_DELAY=700ms
# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
